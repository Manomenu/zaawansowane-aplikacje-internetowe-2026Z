# Line endings: LF in the repo and in every checkout, whatever the OS (matches .editorconfig).
* text=auto eol=lf

# Binary: never diffed as text, never normalised.
*.docx binary
*.xlsx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff2 binary

# Generated: collapsed in GitHub diffs and left out of language stats. Never edited by hand —
# lockfiles come from uv/pnpm, the API types from scripts/.internal/api-types.sh, the ERD picture
# from the Mermaid block of docs/erd.md (mermaid-cli). The ERD's SVG is one huge line per element,
# unreadable as a diff and too big for suwgit's commit message model: shown as "binary differs";
# review the change in docs/erd.md.
uv.lock linguist-generated=true
**/pnpm-lock.yaml linguist-generated=true
**/src/api/openapi.d.ts linguist-generated=true
docs/erd.svg linguist-generated=true -diff
