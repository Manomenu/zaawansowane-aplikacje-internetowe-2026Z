server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # The security headers for every response, error pages included (security-headers.conf).
    include /etc/nginx/snippets/security-headers.conf;

    # Liveness for the container itself. Deliberately independent of the API: the page
    # is still servable when the server behind it is down.
    location = /healthz {
        access_log off;
        include /etc/nginx/snippets/security-headers.conf;
        add_header content-type text/plain always;
        return 200 "ok\n";
    }

    # The live stream (Server-Sent Events) stays open for as long as the page does: no
    # buffering, or events would wait in nginx; a long read timeout, because the server only
    # sends a comment every 15 s. Otherwise the same proxy as /api/ below.
    location = /api/measurements/stream {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $api_upstream ${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 1h;
        # As in /api/ below: the page's headers replace the server's copies.
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
    }

    # Swagger UI (the server's /docs): FastAPI's page loads its script and styles from jsDelivr and
    # starts them with an inline script, which the page's policy (security-headers.conf) forbids.
    # This one HTML page, which carries no data, gets a policy allowing exactly that; every other
    # response keeps the strict one.
    location = /api/docs {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $api_upstream ${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https://fastapi.tiangolo.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    # The browser only ever sees one origin, exactly as it does behind the vite proxy in
    # development — which is why the API's CORS list never has to learn about deployments.
    #
    # The upstream goes through a variable so nginx looks the name up again (every 10 s)
    # instead of once at start: a recreated server container gets a new address, and a
    # cached one answers 502. The resolvers are the container's own, from /etc/resolv.conf
    # (NGINX_ENTRYPOINT_LOCAL_RESOLVERS in the Dockerfile). nginx's resolver knows no search
    # domains, so on the cluster API_UPSTREAM is the full service name.
    location /api/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $api_upstream ${API_UPSTREAM};
        # Strips the /api prefix; proxy_pass with a variable and no path sends this URI on.
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The page's headers (inherited from the server block) replace the server's own copies,
        # so each header is sent once.
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
    }

    # Vite emits content-hashed filenames, so these can never go stale.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header cache-control "public, max-age=31536000, immutable";
    }

    # Single page app. index.html must not be cached or a browser keeps asking for the
    # previous release's asset names after a deploy.
    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/snippets/security-headers.conf;
        add_header cache-control "no-cache";
    }
}
