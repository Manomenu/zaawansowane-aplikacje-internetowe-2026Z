# Origins the web UI is served from — JSON list. Only matters when the browser calls the
# API directly; behind the vite proxy or nginx it sees one origin and CORS never comes up.
CORS_ORIGINS=["http://localhost:3220"]

# Override the committed defaults from .env.base when the port is taken.
# PORT=6220

# The first administrator, created at start-up when both are set and no admin exists yet.
# Pick your own password; the cluster reads these from the server's Secret.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=<choose-a-password>

# Prefix clients see before the routes (used in Location headers) and the login lifetime.
# PUBLIC_API_PREFIX=/api
# TOKEN_TTL_SECONDS=3600

# Most live streams (GET /measurements/stream) open at once; each holds a database connection.
# MAX_STREAMS=50
